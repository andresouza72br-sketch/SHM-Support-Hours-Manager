# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Code and text files
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf


# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.sqlite3 binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
